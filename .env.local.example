# Copy this file to .env.local before running the app.
# This app is fully client-side now — it calls the real backend directly
# from the browser using a token stored in localStorage. There is no
# server-side auth, no cookie, and no local dummy database anymore.

NEXT_PUBLIC_API_BASE_URL=https://server-dot-project-59dfa9fb-4c35-49cd-856.el.r.appspot.com

NEXT_PUBLIC_APP_NAME="Shama Fireworks Cash Portal"

# Thermal printer (placeholder — see README)
NEXT_PUBLIC_PRINTER_NAME="Thermal — Front counter"

# How often the pending queue auto-refreshes, in seconds. Lower = operators
# see each other's approvals sooner, at the cost of more requests.
NEXT_PUBLIC_POLL_INTERVAL_SECONDS=10
